# Copy to project root as .env (never commit .env).
BREEZE_API_KEY=
BREEZE_SECRET=
# Session: ICICI requires browser login + OTP. Semi-automated helper (opens login, validates, writes .env):
#   python scripts/breeze_session.py
BREEZE_SESSION_TOKEN=

GEMINI_API_KEY=
# Optional extra keys (rotation on 429 / quota): same order as listed.
# GEMINI_API_KEY_2=
# Or comma-separated: GEMINI_API_KEYS=key_a,key_b
# Optional; default in code is gemini-2.5-flash-lite. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=
# Quota: set to false to skip the second Gemini call when compliance repair would run (saves 1 call on policy fail).
# GEMINI_COMPLIANCE_RETRY=false
# Compact JSON in prompts (default true); set false for readable debug payloads only.
# GEMINI_COMPACT_PROMPT=true
#
# Portfolio digest email / UI: one extra Gemini call for a short bullet "Portfolio brief" section (requires API key).
# TITAN_PORTFOLIO_LLM_SUMMARY=0

SUPABASE_URL=
SUPABASE_KEY=
TITAN_ENABLE_ANALYSIS_STORE=0

# Optional: email the same post text after each successful --live (SMTP). GitHub Actions: add as repository secrets.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=you@example.com
# SMTP_USE_TLS=true

# Optional all-sector mail mode:
# default (unset/0): one email per sector during --all-sectors
# set to 1/true: send one consolidated email after all sectors complete
# TITAN_ALL_SECTORS_SINGLE_DIGEST=0

# Optional: include volPartCap + calibration method in sector digest email lines (default off).
# TITAN_DIGEST_VERBOSE_VPR=0
# Optional: per-symbol sector digest as one long diagnostic line (default is a short readable block).
# TITAN_DIGEST_VERBOSE_SYMBOLS=0
