# Copy to project root as .env (never commit .env).
BREEZE_API_KEY=
BREEZE_SECRET=
# Session: ICICI requires browser login + OTP. Semi-automated helper (opens login, validates, writes .env):
#   python scripts/breeze_session.py
BREEZE_SESSION_TOKEN=

GEMINI_API_KEY=
# Optional extra keys (rotation on 429 / quota): same order as listed.
# GEMINI_API_KEY_2=
# Or comma-separated: GEMINI_API_KEYS=key_a,key_b
# Optional; default in code is gemini-2.5-flash-lite. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=
# Quota: set to false to skip the second Gemini call when compliance repair would run (saves 1 call on policy fail).
# GEMINI_COMPLIANCE_RETRY=false
# Free tier (e.g. flash-lite) has low daily caps — if the sector digest LLM fails, still finish the run with a
# metrics-only digest (default true). Set false to require LLM text (fail the job on quota errors).
# GEMINI_SECTOR_DIGEST_FAIL_OPEN=true
# Minimum seconds between Gemini generate_content calls (process-wide; default 45). Set 0 to disable.
# GEMINI_MIN_CALL_INTERVAL_SECONDS=45
# Optional extra sleep between sectors for --all-sectors when --all-sector-workers 1 (default 0; brain throttle applies).
# TITAN_ALL_SECTORS_DELAY_SECONDS=0
# Compact JSON in prompts (default true); set false for readable debug payloads only.
# GEMINI_COMPACT_PROMPT=true
#
# Portfolio digest email / UI: one extra Gemini call for a short bullet "Portfolio brief" section (requires API key).
# TITAN_PORTFOLIO_LLM_SUMMARY=0
# Custom `--custom-symbols` text (messy labels): optional Gemini symbol disambiguation when candidates collide (default on).
# TITAN_CUSTOM_SYMBOL_LLM=1

# Supabase project (local dev). Production/CI news keys live in public.titan_secrets;
# see sql/create_titan_secrets.sql and scripts/apply_titan_secrets_migration.py (never commit values).
SUPABASE_URL=
SUPABASE_KEY=
TITAN_ENABLE_ANALYSIS_STORE=0

# Optional: email the same post text after each successful --live (SMTP). GitHub Actions: add as repository secrets.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=you@example.com
# SMTP_USE_TLS=true
# Optional: socket timeout seconds for connect/send (avoids hung CI on bad SMTP).
# SMTP_TIMEOUT_SECONDS=60

# Optional all-sector mail mode:
# All-sector runs: default is one success email per sector. Set to 1/true for one consolidated email at the end.
# TITAN_ALL_SECTORS_SINGLE_DIGEST=0

# Optional: include volPartCap + calibration method in sector digest email lines (default off).
# TITAN_DIGEST_VERBOSE_VPR=0
# Optional: per-symbol sector digest as one long diagnostic line (default is a short readable block).
# TITAN_DIGEST_VERBOSE_SYMBOLS=0

# Breeze anti-idle protections:
# Hard timeout (seconds) around each historical data call; timed-out symbols are marked data_fetch_timeout.
# Set 0 to disable (not recommended).
# BREEZE_HISTORICAL_CALL_TIMEOUT_SECONDS=25

# Sector runner anti-idle protections:
# Heartbeat cadence for pending/done futures logs while a sector is running.
# TITAN_SECTOR_HEARTBEAT_SECONDS=30
# No-progress watchdog threshold (seconds). When exceeded, pending futures are aborted and sector run continues/ends cleanly.
# TITAN_SECTOR_NO_PROGRESS_TIMEOUT_SECONDS=180

# V12 per-symbol news pipeline (NewsAPI, Finnhub, RSS) — see src/news_client.py, news_store.py
# Production/CI: store key *names* below in Supabase public.titan_secrets (service_role only).
# Local .env overrides env; runtime uses src/news_config.load_news_runtime_config() (env first, then DB).
# Upsert from local .env: SUPABASE_ACCESS_TOKEN + SUPABASE_URL, then scripts/apply_titan_secrets_migration.py
# CI bootstrap: one GitHub secret (SUPABASE_ACCESS_TOKEN or SUPABASE_KEY) + SUPABASE_URL; see news_fetch.yml
# Key names (do not commit values): NEWSAPI_API_KEY, FINNHUB_API_KEY, TITAN_NEWS_FEEDS, SUPABASE_URL, SUPABASE_KEY
# https://newsapi.org/register
# NEWSAPI_API_KEY=
# https://finnhub.io/register
# FINNHUB_API_KEY=
# Default sentiment model: vader (CI-safe). Optional: finbert (requires requirements-news.txt).
# TITAN_SENTIMENT_MODEL=vader

# Optional global-news influence for sector prioritization:
# Comma-separated RSS/Atom feeds (defaults include BBC/NYT/Al Jazeera world feeds).
# TITAN_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml
# Freshness cutoff for news ingestion.
# TITAN_NEWS_MAX_AGE_HOURS=36
# Snapshot TTL used by run/ranking path before forcing refresh.
# TITAN_NEWS_SNAPSHOT_TTL_HOURS=2
# Macro sector snapshot table (sector_priority global news; not per-symbol cache).
# TITAN_NEWS_SNAPSHOT_TABLE=global_news_snapshots
# Per-symbol snapshot table (news_store cache).
# TITAN_SYMBOL_NEWS_SNAPSHOT_TABLE=symbol_news_snapshots
# Hard cap on deduped news items considered.
# TITAN_NEWS_FETCH_LIMIT=40
# Blend control: sector_news_score (-1..1) is multiplied by weight, then clipped by cap.
# TITAN_NEWS_BLEND_WEIGHT=3.5
# TITAN_NEWS_BLEND_CAP=3
# Number of top news drivers persisted in explainability fields.
# TITAN_NEWS_DRIVER_LIMIT=3

# Legacy Google RSS stock-news path in sector_priority (macro correlation digest lines).
# TITAN_STOCK_NEWS_FETCH_LIMIT=8
# TITAN_STOCK_NEWS_COVERAGE_TOP_N=10
